    "#print(\"ACF Values:\", acf_values)\n",
    "#print(\"PACF Values:\", pacf_values)\n",
    "\n",
    "from statsmodels.tsa.statespace.sarimax import SARIMAX\n",
    "\n",
    "# 1. Definir o modelo (p, d, q)\n",
    "# Por enquanto não usaremos o 'S' (Sazonal), apenas ARIMA puro\n",
    "modelo = SARIMAX(df_sarimax, order=(1, 1, 1))\n",
    "\n",
    "# 2. Treinar o modelo\n",
    "resultado_fit = modelo.fit(disp=False)\n",
    "\n",
    "# 3. Ver o resumo estatístico\n",
    "#print(resultado_fit.summary())\n",
    "\n",
    "# 4. Diagnóstico de Resíduos (Fundamental!)\n",
    "#resultado_fit.plot_diagnostics(figsize=(12, 8))\n",
    "#plt.show()\n",
    "\n",
    "# 1. Gerar previsão para os próximos 5 dias úteis\n",
    "n_days = 5\n",
    "forecast_obj = resultado_fit.get_forecast(steps=n_days)\n",
    "\n",
    "# 2. Extrair o valor médio e os intervalos de confiança\n",
    "forecast_mean = forecast_obj.predicted_mean\n",
    "confidence_intervals = forecast_obj.conf_int()\n",
    "\n",
    "# 3. Criar datas para o índice da previsão (dias úteis)\n",
    "ultima_data = df_precos_selecao['data'].max()\n",
    "forecast_dates = pd.date_range(start=ultima_data, periods=n_days + 1, freq='B')[1:]\n",
    "\n",
    "# 4. Plotar o resultado final\n",
    "plt.figure(figsize=(12, 6))\n",
    "# Mostrar os últimos 30 dias para contexto\n",
    "plt.plot(df_precos_selecao['data'][-30:], df_precos_selecao['preco_fechamento'][-30:], label='Histórico Recente')\n",
    "plt.plot(forecast_dates, forecast_mean, label='Previsão', color='red', marker='o')\n",
    "\n",
    "# Pintar a área de incerteza (O intervalo de confiança)\n",
    "plt.fill_between(forecast_dates, \n",
    "                 confidence_intervals.iloc[:, 0], \n",
    "                 confidence_intervals.iloc[:, 1], \n",
    "                 color='pink', alpha=0.3, label='Intervalo de Confiança (95%)')\n",
    "\n",
    "plt.title(f\"Previsão SARIMAX para os próximos {n_days} dias - {ticker_selecionado}\")\n",
    "plt.legend()\n",
    "plt.grid(True, alpha=0.3)\n",
    "plt.show()\n",
    "\n",
    "print(\"Previsão de Preços:\")\n",
    "print(pd.DataFrame({'Data': forecast_dates, 'Preço Previsto': forecast_mean.values}))\n"
