    "from pmdarima import plot_acf, plot_pacf\n",
    "from scipy import stats\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import statsmodels.api as sm\n",
    "import statsmodels.tsa.stattools as ts\n",
    "import matplotlib.pyplot as plt\n",
    "import warnings\n",
    "from dashboard.queries import (\n",
    "    QUERY_PRECOS\n",
    ")\n",
    "from dashboard.db import get_engine\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "engine = get_engine()\n",
    "\n",
    "df_precos = pd.read_sql(QUERY_PRECOS, engine)\n",
    "ticker_selecionado = \"PETR4.SA\"\n",
    "\n",
    "df_precos_selecao = df_precos[df_precos[\"ticker\"] == ticker_selecionado]\n",
    "df_sarimax = df_precos_selecao[\"preco_fechamento\"].copy()\n",
    "\n",
    "# Verificar a estacionariedade usando o teste de Dickey-Fuller aumentado\n",
