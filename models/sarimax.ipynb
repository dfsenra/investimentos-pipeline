    "#else:\n",
    "#    df_sarimax_diff = df_sarimax\n",
    "\n",
    "# Identificar os parâmetros p, d, q usando o gráfico de autocorrelação e autocorrelação parcial\n",
    "#from statsmodels.graphics.tsaplots import plot_acf, plot_pacf\n",
    "#import matplotlib.pyplot as plt\n",
    "#plot_acf(df_sarimax_diff)\n",
    "#plot_pacf(df_sarimax_diff)\n",
    "#plt.show()\n",
    "\n",
    "#acf_values = sm.tsa.acf(df_sarimax, nlags=20)\n",
